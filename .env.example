# Environment Configuration for GraphMind

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
PROJECT_NAME="GraphMind — Adaptive Agentic GraphRAG"
BACKEND_VERSION="0.1.0"
API_PREFIX="/api/v1"
BACKEND_PORT=8000
FRONTEND_PORT=3000

# LLM Provider (options: gemini, openai, anthropic, ollama, mock)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Embedding Configuration (options: huggingface, openai, gemini)
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Vector Store (ChromaDB)
VECTOR_STORE_PROVIDER=chromadb
CHROMA_PERSIST_DIR=./data/processed/chroma
CHROMA_COLLECTION_NAME=olympic_corpus

# Graph Store (TigerGraph)
GRAPH_STORE_PROVIDER=tigergraph
TIGERGRAPH_HOST=http://127.0.0.1
TIGERGRAPH_RESTPP_PORT=9000
TIGERGRAPH_GS_PORT=14240
TIGERGRAPH_GRAPH_NAME=OlympicGraph
TIGERGRAPH_USERNAME=tigergraph
TIGERGRAPH_PASSWORD=tigergraph
TIGERGRAPH_SECRET=your_tigergraph_secret_here
TIGERGRAPH_TOKEN=your_tigergraph_token_here

# Agent & Investigation Settings
MAX_AGENT_ITERATIONS=6
TOKEN_BUDGET_LIMIT=8000
DEFAULT_TOP_K=5
